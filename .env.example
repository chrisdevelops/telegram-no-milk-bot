# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here

# Database Configuration (optional, defaults to ./grocery.db)
# DB_PATH=./grocery.db

# Feature Flags
# Optional: Delete command messages after execution
# DELETE_COMMAND_MESSAGES=true

# Optional: Auto-render list after add/remove/check commands (default: true)
# Set to false to only show list when explicitly requested with 'grocery show'
# RENDER_LIST_AFTER_CHANGES=true

# History Tracking Configuration
# Enable/disable command history tracking (default: true)
# HISTORY_ENABLED=true

# Maximum number of history entries per chat (default: 100, 0 = unlimited)
# HISTORY_MAX_ENTRIES=100

# User display format in history: 'username', 'userid', or 'both' (default: both)
# HISTORY_USER_FORMAT=both
